ANTHROPIC_API_KEY=sk-ant-...

# 分類モード: true=ローカル(Moondream2・APIキー不要) / false=Claude Vision API
USE_LOCAL_MODEL=true

# Sensing
SNAPSHOT_INTERVAL_SECONDS=600
SNAPSHOT_INTERVAL_MIN=300
SNAPSHOT_INTERVAL_MAX=900

# Privacy
EDGE_AI_ONLY=true
RETAIN_RAW_IMAGE_SECONDS=0

# Database
# Local:  sqlite+aiosqlite:///./data/focus_guardian.db
# Vercel: postgres://user:pass@host/db  (Vercel Postgres connection string)
DATABASE_URL=sqlite+aiosqlite:///./data/focus_guardian.db

# Serverless mode — set to true on Vercel (disables background scheduler)
IS_SERVERLESS=false

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

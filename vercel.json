{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "framework": "nextjs",
  "functions": {
    "api/backend.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/backend"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/snapshot/manual",
      "schedule": "0 9 * * *"
    }
  ]
}
